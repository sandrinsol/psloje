{
  "rom": "build/game.cue",
  "steps": [
    { "waitUntil": { "address": "frame_count", "as": "u32", "op": "gte", "value": 160 }, "maxFrames": 1500 },
    { "assertRam": "cd_errors", "as": "s32", "equals": 0 },
    { "assertRam": "tiles_loaded", "as": "s32", "min": 9 },
    { "assertRam": "speed_kmh", "as": "s32", "equals": 0 },
    { "assertRam": "faces_drawn", "as": "s32", "min": 50 },
    { "assertRam": "money", "as": "s32", "equals": 1000 },
    { "assertRam": "fare_state", "as": "s32", "equals": 1 },
    { "wait": 30 },
    { "assertRam": "route_count", "as": "s32", "min": 2 },
    { "assert": "goldens/start.png", "ignore": [{ "x": 0, "y": 4, "w": 320, "h": 12 }, { "x": 0, "y": 220, "w": 320, "h": 20 }] },
    { "hold": "R2", "frames": 240 },
    { "assertRam": "speed_kmh", "as": "s32", "min": 12, "max": 30 },
    { "assertRam": "fps", "as": "s32", "min": 25 },
    { "hold": "R2", "frames": 400 },
    { "assertRam": "speed_kmh", "as": "s32", "min": 28, "max": 30 },
    { "hold": "L2", "frames": 120 },
    { "assertRam": "speed_kmh", "as": "s32", "max": 5 },
    { "tap": "TRIANGLE" },
    { "wait": 70 },
    { "assertRam": "bigmap_open", "as": "s32", "equals": 1 },
    { "assertRam": "fps", "as": "s32", "min": 25 },
    { "tap": "R1" },
    { "wait": 70 },
    { "assertRam": "fps", "as": "s32", "min": 25 },
    { "tap": "TRIANGLE" },
    { "wait": 10 },
    { "assertRam": "bigmap_open", "as": "s32", "equals": 0 },
    { "write": "game_minutes", "value": 1320, "as": "u32" },
    { "wait": 30 },
    { "assertRam": "game_minutes", "as": "s32", "min": 1320, "max": 1322 },
    { "assert": "goldens/night.png", "ignore": [{ "x": 0, "y": 4, "w": 320, "h": 12 }, { "x": 0, "y": 220, "w": 320, "h": 20 }] },
    { "assertRam": "cd_errors", "as": "s32", "equals": 0 }
  ]
}
