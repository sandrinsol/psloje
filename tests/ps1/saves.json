{
  "rom": "build/game.cue",
  "steps": [
    {"name": "a blank card in slot 1", "importCard": "cards/blank.mcr", "slot": 1},
    {"waitUntil": {"address": "boot_magic", "as": "u32", "op": "eq", "value": 1372913665}, "maxFrames": 3000},
    {"name": "no save yet: one is made", "waitUntil": {"address": "save_state", "as": "s32", "op": "eq", "value": 2}, "maxFrames": 600},
    {"waitUntil": {"address": "screen", "as": "s32", "op": "eq", "value": 0}, "maxFrames": 600},
    {"name": "(as if three trials were met)", "write": "record", "value": 7, "as": "u32"},
    {"write": "record+4", "value": 15000, "as": "u32"},
    {"wait": 30},
    {"tap": "START"},
    {"wait": 20},
    {"name": "title menu: OPTIONS", "tap": "DOWN"},
    {"tap": "DOWN"},
    {"tap": "CROSS"},
    {"wait": 20},
    {"name": "leaving the options saves", "tap": "CIRCLE"},
    {"wait": 30},
    {"assertRam": "save_state", "as": "s32", "equals": 2},
    {"name": "switched off and on again", "reset": true},
    {"waitUntil": {"address": "boot_magic", "as": "u32", "op": "eq", "value": 1372913665}, "maxFrames": 3000},
    {"name": "the save is read back", "waitUntil": {"address": "save_state", "as": "s32", "op": "eq", "value": 1}, "maxFrames": 600},
    {"assertRam": "record", "as": "u32", "equals": 7},
    {"assertRam": "record+4", "as": "u32", "equals": 15000},
    {"waitUntil": {"address": "screen", "as": "s32", "op": "eq", "value": 0}, "maxFrames": 600},
    {"wait": 30},
    {"tap": "START"},
    {"wait": 20},
    {"name": "title menu: TRIALS", "tap": "DOWN"},
    {"tap": "CROSS"},
    {"wait": 20},
    {"assert": "goldens/trials.png"},
    {"name": "Circle: back to the title menu", "tap": "CIRCLE"},
    {"wait": 20},
    {"assert": "goldens/trials_back.png"}
  ]
}
